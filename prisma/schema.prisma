datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum NewsCategory {
  SEGURIDAD
  REGION
  INFRAESTRUCTURA
  DEPORTES
  CULTURA
  OPINION
}

model News {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  imageUrl    String
  category    NewsCategory
  publishedAt DateTime     @default(now())
  readMinutes Int          @default(2)
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String
  schedule    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
